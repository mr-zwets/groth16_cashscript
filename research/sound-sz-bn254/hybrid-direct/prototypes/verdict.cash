pragma cashscript ^0.14.0;

import "../../../../singleton/bn254/lib/lazy/Bn254LazyG.cash";

// Terminal torus verdict on a 6-limb checkpoint state G (hybrid-direct):
// [tau(G) * c^(p^2)] == [c^p * c^(p^3)] in Fp12*/Fp6*, with c = [1 + u*w].
// tau(a)*tau(b) = (1 + v*a*b) + w*(a + b); cross-multiply the two projective representatives.
contract TorusVerdict6() {
    function spend(int G0, int G1, int G2, int G3, int G4, int G5, int u0, int u1, int u2, int u3, int u4, int u5) {
        (int t10,int t11,int t12,int t13,int t14,int t15) = torusFrob1(u0,u1,u2,u3,u4,u5);
        (int t20,int t21,int t22,int t23,int t24,int t25) = torusFrob2(u0,u1,u2,u3,u4,u5);
        (int t30,int t31,int t32,int t33,int t34,int t35) = torusFrob2(t10,t11,t12,t13,t14,t15);
        (int a0,int a1,int a2,int a3,int a4,int a5) = fp6MulRaw(G0,G1,G2,G3,G4,G5, t20,t21,t22,t23,t24,t25);
        (int q0,int q1,int q2,int q3,int q4,int q5) = fp6MulRaw(t10,t11,t12,t13,t14,t15, t30,t31,t32,t33,t34,t35);
        // lhs = (1 + v*a, G + t2), rhs = (1 + v*q, t1 + t3); v*(x0,x1,x2) = (xi*x2, x0, x1), xi = 9 + u
        (int cl0,int cl1,int cl2,int cl3,int cl4,int cl5) = fp6MulRaw((1 + 9*a4 - a5) % 21888242871839275222246405745257275088696311157297823662689037894645226208583, (a4 + 9*a5) % 21888242871839275222246405745257275088696311157297823662689037894645226208583, a0 % 21888242871839275222246405745257275088696311157297823662689037894645226208583, a1 % 21888242871839275222246405745257275088696311157297823662689037894645226208583, a2 % 21888242871839275222246405745257275088696311157297823662689037894645226208583, a3 % 21888242871839275222246405745257275088696311157297823662689037894645226208583, t10+t30,t11+t31,t12+t32,t13+t33,t14+t34,t15+t35);
        (int cr0,int cr1,int cr2,int cr3,int cr4,int cr5) = fp6MulRaw(G0+t20,G1+t21,G2+t22,G3+t23,G4+t24,G5+t25, (1 + 9*q4 - q5) % 21888242871839275222246405745257275088696311157297823662689037894645226208583, (q4 + 9*q5) % 21888242871839275222246405745257275088696311157297823662689037894645226208583, q0 % 21888242871839275222246405745257275088696311157297823662689037894645226208583, q1 % 21888242871839275222246405745257275088696311157297823662689037894645226208583, q2 % 21888242871839275222246405745257275088696311157297823662689037894645226208583, q3 % 21888242871839275222246405745257275088696311157297823662689037894645226208583);
        require(mulFp(cl0 - cr0, 1) == 0); require(mulFp(cl1 - cr1, 1) == 0); require(mulFp(cl2 - cr2, 1) == 0);
        require(mulFp(cl3 - cr3, 1) == 0); require(mulFp(cl4 - cr4, 1) == 0); require(mulFp(cl5 - cr5, 1) == 0);
    }
}
